        "body": {
          "mode": "raw",
          "raw": "{\"tipo\":\"GENERAL\",\"titulo\":\"Resumen actualizado\",\"resumen\":\"Actualizado\",\"detalles\":[{\"concepto\":\"Sábanas disponibles\",\"valor\":45}]}"
        }
      }
    },
