          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"\",\n  \"password\": \"\"\n}"
        }
      }
    },
    {
      "name": "Crear usuario BODEGA",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Crear usuario BODEGA -> HTTP 201\", function () { pm.response.to.have.status(201); });",
              "pm.collectionVariables.set('userId', pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/usuarios",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"username\":\"bodega_{{$timestamp}}\",\"password\":\"clave123\",\"rol\":\"BODEGA\"}"
        }
      }
    },
    {
      "name": "Listar usuarios",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Listar usuarios -> HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
